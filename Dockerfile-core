FROM alpine:3

ARG UNIMUS_VERSION="-%20Latest"
ARG UNIMUS_SHA256=""

LABEL org.opencontainers.image.authors="JoKneeMo <https://github.com/JoKneeMo>"
LABEL org.opencontainers.image.source="https://github.com/JoKneeMo/unimus-docker"
LABEL org.opencontainers.image.title="Unimus Core"
LABEL org.opencontainers.image.version="${UNIMUS_VERSION}"

RUN apk update && apk add --no-cache \
    curl \
    ca-certificates \
    wget \
    less \
    tzdata \
    iputils \
    tini \
    bash \
    openjdk21-jre-headless \
    && addgroup -S -g 1000 unimus \
    && adduser -S -D -u 1000 -G unimus unimus \
    && echo "UTC" > /etc/timezone

RUN if [ "${UNIMUS_VERSION}" = "dev" ]; then \
        DOWNLOAD_URL="https://unimus.net/download-unimus-core/dev-builds/Unimus-Core.jar"; \
    else \
        DOWNLOAD_URL="https://download.unimus.net/unimus-core/${UNIMUS_VERSION}/Unimus-Core.jar"; \
    fi \
    && curl -fSL --retry 3 "${DOWNLOAD_URL}" --create-dirs -o /opt/unimus-core/Unimus-Core.jar \
    && if [ -n "${UNIMUS_SHA256}" ]; then \
        echo "${UNIMUS_SHA256}  /opt/unimus-core/Unimus-Core.jar" | sha256sum -c -; \
    fi \
    && mkdir -p \
        /etc/unimus-core \
        /var/log/unimus-core \
    && touch \
        /etc/unimus-core/unimus-core.properties \
    && chown -R unimus:unimus \
        /opt/unimus-core \
        /etc/unimus-core \
        /var/log/unimus-core \
        /etc/timezone

COPY --chmod=755 entrypoint-core.sh /entrypoint.sh

WORKDIR /opt/unimus-core

USER unimus

ENV TZ=UTC \
    MAKE_PROPERTIES=true

ENTRYPOINT ["tini", "-g", "--", "/entrypoint.sh"]
